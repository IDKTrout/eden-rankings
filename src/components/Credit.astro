---
// Credit for the people who gathered a season's rankings, from the seasons tab
// (compiled_by and thanks).
import type { Season } from '../lib/data';
interface Props {
  season: Season;
  compact?: boolean;
}
const { season, compact = false } = Astro.props;
---
{(season.compiledBy || season.thanks) && (
  <p class:list={['credit', { compact }]}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 2l2.9 6.1 6.6.8-4.9 4.6 1.3 6.5L12 16.8 6.1 20l1.3-6.5L2.5 8.9l6.6-.8z" fill="currentColor" /></svg>
    <span>
      {season.compiledBy && <>Rankings gathered by <strong>{season.compiledBy}</strong>.</>}
      {season.compiledBy && season.thanks && ' '}{season.thanks}
    </span>
  </p>
)}

<style>
  .credit { display: flex; gap: .5rem; align-items: flex-start; background: var(--raised); border: 1px solid var(--line); border-radius: 8px; padding: .55rem .8rem; font-size: .9rem; max-width: 62ch; }
  .credit svg { color: var(--accent); flex: none; margin-top: .2rem; }
  .credit strong { font-weight: 600; }
  .credit.compact { background: none; border: 0; padding: 0; font-size: .8rem; color: var(--muted); }
  .credit.compact svg { width: 13px; height: 13px; margin-top: .15rem; }
</style>
