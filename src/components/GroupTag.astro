---
// Small tag naming a guild's group, in the group's color from the groups tab.
import { groupById, groupOf, groupColor } from '../lib/data';
interface Props {
  guildId?: string;
  groupId?: string;
  full?: boolean;
  /** Set false inside another link (a link can't contain a link). */
  link?: boolean;
}
const { guildId, groupId, full = false, link = true } = Astro.props;
const group = groupId ? groupById.get(groupId) : guildId ? groupOf(guildId) : undefined;
const style = group ? `--c:${groupColor(group.id)}` : '';
---
{group && (link
  ? <a class="gtag" href={`/group/${encodeURIComponent(group.id)}/`} style={style} title={`${group.name} group`}>{full ? group.name : group.short}</a>
  : <span class="gtag" style={style}>{full ? group.name : group.short}</span>
)}

<style>
  .gtag {
    display: inline-block; vertical-align: 1px; margin-left: .4rem;
    font-size: .68rem; font-weight: 600; letter-spacing: .03em; line-height: 1;
    padding: .2rem .4rem; border-radius: 4px; text-decoration: none; white-space: nowrap;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
    background: color-mix(in srgb, var(--c) 14%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 45%, var(--surface));
  }
  .gtag:hover { color: var(--ink); text-decoration: none; }
</style>
