---
// A dot chart drawn as SVG at build time. Hovering a dot shows its label (native tooltip).
// It is drawn twice, at desktop and phone widths, so tick labels stay readable on a phone
// instead of shrinking with the chart; CSS shows the one that fits.
interface Point {
  x: number;
  y: number;
  label: string;
  highlight?: boolean;
  href?: string;
}
interface Props {
  points: Point[];
  label: string;
  xTicks?: (v: number) => string;
  yTicks?: (v: number) => string;
  line?: boolean;
  reverseX?: boolean;
  height?: number;
}
const { points, label, xTicks = (v) => String(v), yTicks = (v) => String(v), line = false, reverseX = false, height = 300 } = Astro.props;

function niceTicks(min: number, max: number, count = 5) {
  if (min === max) { min -= 1; max += 1; }
  const span = max - min;
  const step0 = span / count;
  const mag = 10 ** Math.floor(Math.log10(step0));
  const err = step0 / mag;
  const step = (err >= 7.5 ? 10 : err >= 3.5 ? 5 : err >= 1.5 ? 2 : 1) * mag;
  const lo = Math.floor(min / step) * step;
  const hi = Math.ceil(max / step) * step;
  const ticks = [];
  for (let v = lo; v <= hi + step / 2; v += step) ticks.push(Number(v.toFixed(10)));
  return { lo, hi, ticks };
}

const xs = points.map((p) => p.x);
const ys = points.map((p) => p.y);

/** Lays the chart out for one drawing width. Font size is in drawing units, so a narrow drawing keeps labels large on a phone. */
function layout(W: number, H: number, xCount: number, yCount: number, font: number, r: number) {
  const xt = niceTicks(Math.min(...xs), Math.max(...xs), xCount);
  const yt = niceTicks(Math.min(...ys), Math.max(...ys), yCount);
  const yLabelW = Math.max(...yt.ticks.map((t) => yTicks(t).length)) * font * 0.6 + 12;
  const m = { l: yLabelW, r: 14, t: 10, b: font + 18 };
  const sx = (v: number) => {
    const f = (v - xt.lo) / (xt.hi - xt.lo || 1);
    return m.l + (reverseX ? 1 - f : f) * (W - m.l - m.r);
  };
  const sy = (v: number) => H - m.b - ((v - yt.lo) / (yt.hi - yt.lo || 1)) * (H - m.t - m.b);
  const path = line ? points.map((p, i) => `${i ? 'L' : 'M'}${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join('') : '';
  return { W, H, xt, yt, m, sx, sy, path, font, r };
}

const sizes = [
  { cls: 'wide', ...layout(480, height, 5, 5, 15, 5.5) },
  { cls: 'narrow', ...layout(320, Math.round(height * 0.9), 3, 4, 13, 4.5) },
];
---
{sizes.map((c) => (
  <svg class={`scatter ${c.cls}`} viewBox={`0 0 ${c.W} ${c.H}`} role="img" aria-label={label} preserveAspectRatio="xMidYMid meet" style={`--fs:${c.font}px`}>
    {c.yt.ticks.map((t) => (
      <g>
        <line x1={c.m.l} x2={c.W - c.m.r} y1={c.sy(t)} y2={c.sy(t)} class="grid" />
        <text x={c.m.l - 6} y={c.sy(t)} dy="0.35em" text-anchor="end">{yTicks(t)}</text>
      </g>
    ))}
    {c.xt.ticks.map((t) => (
      <text x={c.sx(t)} y={c.H - c.m.b + c.font + 4} text-anchor="middle">{xTicks(t)}</text>
    ))}
    <line x1={c.m.l} x2={c.W - c.m.r} y1={c.H - c.m.b} y2={c.H - c.m.b} class="axis" />
    {line && <path d={c.path} class="trend" />}
    {points.map((p) => (
      p.href
        ? <a href={p.href}><circle cx={c.sx(p.x)} cy={c.sy(p.y)} r={c.r} class:list={['dot', { hi: p.highlight }]}><title>{p.label}</title></circle></a>
        : <circle cx={c.sx(p.x)} cy={c.sy(p.y)} r={c.r} class:list={['dot', { hi: p.highlight }]}><title>{p.label}</title></circle>
    ))}
  </svg>
))}

<style>
  .scatter { width: 100%; height: auto; display: block; overflow: visible; }
  .scatter.narrow { display: none; }
  @media (max-width: 560px) {
    .scatter.wide { display: none; }
    .scatter.narrow { display: block; }
  }
  .scatter text { fill: var(--muted); font: var(--fs) var(--font-body); font-variant-numeric: tabular-nums; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .axis { stroke: var(--muted); stroke-width: 1; opacity: .6; }
  .trend { fill: none; stroke: var(--series-1); stroke-width: 2; opacity: .4; }
  .dot { fill: var(--series-1); fill-opacity: .85; stroke: var(--surface); stroke-width: 1.5; }
  .dot.hi { fill: var(--series-2); }
  a:hover .dot, a:focus-visible .dot { stroke: var(--ink); stroke-width: 2; }
</style>
