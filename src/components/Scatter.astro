---
// A dot chart drawn as SVG at build time. Hovering a dot shows its label (native tooltip).
interface Point {
  x: number;
  y: number;
  label: string;
  highlight?: boolean;
  href?: string;
}
interface Props {
  points: Point[];
  label: string;
  xTicks?: (v: number) => string;
  yTicks?: (v: number) => string;
  line?: boolean;
  reverseX?: boolean;
  height?: number;
}
const { points, label, xTicks = (v) => String(v), yTicks = (v) => String(v), line = false, reverseX = false, height = 300 } = Astro.props;

// A narrow drawing width keeps tick labels readable when the chart shrinks to phone width.
const W = 480;
const H = height;

function niceTicks(min: number, max: number, count = 5) {
  if (min === max) { min -= 1; max += 1; }
  const span = max - min;
  const step0 = span / count;
  const mag = 10 ** Math.floor(Math.log10(step0));
  const err = step0 / mag;
  const step = (err >= 7.5 ? 10 : err >= 3.5 ? 5 : err >= 1.5 ? 2 : 1) * mag;
  const lo = Math.floor(min / step) * step;
  const hi = Math.ceil(max / step) * step;
  const ticks = [];
  for (let v = lo; v <= hi + step / 2; v += step) ticks.push(Number(v.toFixed(10)));
  return { lo, hi, ticks };
}

const xs = points.map((p) => p.x);
const ys = points.map((p) => p.y);
const xt = niceTicks(Math.min(...xs), Math.max(...xs), 5);
const yt = niceTicks(Math.min(...ys), Math.max(...ys), 5);

const yLabelW = Math.max(...yt.ticks.map((t) => yTicks(t).length)) * 9 + 14;
const m = { l: yLabelW, r: 16, t: 12, b: 34 };
const sx = (v: number) => {
  const f = (v - xt.lo) / (xt.hi - xt.lo || 1);
  return m.l + (reverseX ? 1 - f : f) * (W - m.l - m.r);
};
const sy = (v: number) => H - m.b - ((v - yt.lo) / (yt.hi - yt.lo || 1)) * (H - m.t - m.b);
const path = line ? points.map((p, i) => `${i ? 'L' : 'M'}${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join('') : '';
---
<svg class="scatter" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
  {yt.ticks.map((t) => (
    <g>
      <line x1={m.l} x2={W - m.r} y1={sy(t)} y2={sy(t)} class="grid" />
      <text x={m.l - 8} y={sy(t)} dy="0.35em" text-anchor="end">{yTicks(t)}</text>
    </g>
  ))}
  {xt.ticks.map((t) => (
    <text x={sx(t)} y={H - m.b + 20} text-anchor="middle">{xTicks(t)}</text>
  ))}
  <line x1={m.l} x2={W - m.r} y1={H - m.b} y2={H - m.b} class="axis" />
  {line && <path d={path} class="trend" />}
  {points.map((p) => (
    p.href
      ? <a href={p.href}><circle cx={sx(p.x)} cy={sy(p.y)} r="5.5" class:list={['dot', { hi: p.highlight }]}><title>{p.label}</title></circle></a>
      : <circle cx={sx(p.x)} cy={sy(p.y)} r="5.5" class:list={['dot', { hi: p.highlight }]}><title>{p.label}</title></circle>
  ))}
</svg>

<style>
  .scatter { width: 100%; height: auto; display: block; overflow: visible; }
  .scatter text { fill: var(--muted); font: 15px var(--font-body); font-variant-numeric: tabular-nums; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .axis { stroke: var(--muted); stroke-width: 1; opacity: .6; }
  .trend { fill: none; stroke: var(--series-1); stroke-width: 2; opacity: .4; }
  .dot { fill: var(--series-1); fill-opacity: .85; stroke: var(--surface); stroke-width: 1.5; }
  .dot.hi { fill: var(--series-2); }
  a:hover .dot, a:focus-visible .dot { stroke: var(--ink); stroke-width: 2; }
</style>
