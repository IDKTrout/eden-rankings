---
import Layout from '../layouts/Layout.astro';
import Rank from '../components/Rank.astro';
import Credit from '../components/Credit.astro';
import {
  latestOf, seasonLabel, abexFor, riftFor, abexSummary, riftSummary, seasons, guildIds, players,
  fmtM, fmtInt, guildLabel, finished, timeNote,
} from '../lib/data';

const abexSeason = latestOf('abex');
const riftSeason = latestOf('rift');
const aSum = abexSeason ? abexSummary(abexSeason.id) : null;
const rSum = riftSeason ? riftSummary(riftSeason.id) : null;
const topAbex = abexSeason ? abexFor(abexSeason.id).filter((r) => r.damageRank != null).slice(0, 10) : [];
const topRift = riftSeason ? riftFor(riftSeason.id).slice(0, 10) : [];
---
<Layout>
  <section class="hero">
    <span class="eyebrow">Event rankings</span>
    <h1>Every ranked guild and player, season by season</h1>
    <p class="lede">AbEx guild damage and Temporal Rift floors, with guild and player histories that follow them through name changes.</p>
    <form class="hero-search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="q">Search guilds and players</label>
      <input id="q" name="q" class="filter" type="search" placeholder="Search a guild or player" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
    <p class="counts muted small">{seasons.length} seasons · {fmtInt(guildIds.length)} guilds · {fmtInt(players.length)} players</p>
  </section>

  <div class="grid-2">
    {abexSeason && aSum && (
      <section class="card" id="latest-abex">
        <div class="card-head">
          <div>
            <span class="eyebrow">Latest AbEx</span>
            <h2 class="display"><a href={`/season/${abexSeason.id}/`}>{seasonLabel(abexSeason)}</a></h2>
          </div>
          <a class="more" href={`/season/${abexSeason.id}/`}>Full ranking →</a>
        </div>
        <Credit season={abexSeason} compact />
        <p class="muted small">{aSum.finished > 1 ? `${aSum.finished} guilds reached the max damage of ${fmtM(aSum.max)}; those are ranked by finish time.` : aSum.finished === 1 && aSum.fastest ? `Only ${aSum.fastest.guildName} reached the max damage of ${fmtM(aSum.max)}.` : `No guild reached the max damage of ${fmtM(aSum.max)}.`} Bold times are finish times; others are last attacks.</p>
        <table class="rank">
          <thead><tr><th class="num">Rank</th><th>Guild</th><th class="num">Damage</th><th class="num">Finish / last attack</th></tr></thead>
          <tbody>
            {topAbex.map((r) => (
              <tr>
                <td class="num"><Rank value={r.damageRank} tiers="abex" /></td>
                <td><a href={`/guild/${encodeURIComponent(r.guildId)}/`}>{r.guildName}</a></td>
                <td class="num">{fmtM(r.damage)}</td>
                <td class="num"><span class:list={{ fin: finished(r) }} title={timeNote(r)}>{r.time || '—'}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}
    {riftSeason && rSum && (
      <section class="card" id="latest-rift">
        <div class="card-head">
          <div>
            <span class="eyebrow">Latest Temporal Rift</span>
            <h2 class="display"><a href={`/season/${riftSeason.id}/`}>{seasonLabel(riftSeason)}</a></h2>
          </div>
          <a class="more" href={`/season/${riftSeason.id}/`}>Full ranking →</a>
        </div>
        <Credit season={riftSeason} compact />
        <p class="muted small">Top floor {fmtInt(rSum.top.floor)}; floor {fmtInt(rSum.cutoff)} made the top {rSum.players}.</p>
        <table class="rank">
          <thead><tr><th class="num">Rank</th><th>Player</th><th class="num">Floor</th><th>Guild</th></tr></thead>
          <tbody>
            {topRift.map((r) => (
              <tr>
                <td class="num"><Rank value={r.rank} /></td>
                <td><a href={`/player/${r.playerId}/`}>{r.playerName}</a></td>
                <td class="num">{fmtInt(r.floor)}</td>
                <td class="guild-cell">{r.guildId ? <a href={`/guild/${encodeURIComponent(r.guildId)}/`}>{guildLabel(r.guildId, r.guildName)}</a> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}
  </div>
</Layout>

<style>
  .hero { display: flex; flex-direction: column; gap: .8rem; padding-block: 1rem .5rem; }
  .hero h1 { font-size: clamp(1.9rem, 5vw, 3rem); max-width: 22ch; }
  .hero-search { display: flex; gap: .5rem; max-width: 520px; margin-top: .4rem; }
  .hero-search .filter { max-width: none; flex: 1; min-width: 0; }
  .hero-search button { font: inherit; font-weight: 600; padding: .6rem 1.1rem; border-radius: 8px; border: 0; background: var(--accent); color: #1b1404; cursor: pointer; }
  .hero-search button:hover { filter: brightness(1.08); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .card-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
  .display { font-family: var(--font-display); font-size: 1.4rem; margin-top: .15rem; }
  .display a { text-decoration: none; }
  .more { font-size: .85rem; font-weight: 500; white-space: nowrap; }
  .guild-cell { max-width: 10rem; overflow: hidden; text-overflow: ellipsis; }
  table.rank th { position: static; }
</style>
