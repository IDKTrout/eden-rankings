---
import Layout from '../../layouts/Layout.astro';
import Rank from '../../components/Rank.astro';
import StatusTag from '../../components/StatusTag.astro';
import GroupTag from '../../components/GroupTag.astro';
import { players, playerById, seasonById, seasonLabel, guildLabel, fmtInt, fmtM, fmtServer, finished, timeNote, nameOf, abex } from '../../lib/data';

export function getStaticPaths() {
  return players.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params as { id: string };
const p = playerById.get(id)!;
const otherNames = p.names.filter((n) => n !== p.name);
const riftNewest = [...p.rift].reverse();
// Guilds this player is tied to: any guild they appear under in a ranking or led in AbEx.
const tiedGuilds = [...new Set([...p.rift, ...p.led].map((r) => r.guildId).filter(Boolean))];
const seasonOrder = (sid: string) => seasonById.get(sid)?.order ?? 0;
// Those guilds' AbEx results, newest season first.
const guildRecords = abex
  .filter((r) => tiedGuilds.includes(r.guildId) && r.damageRank != null)
  .sort((a, b) => seasonOrder(b.seasonId) - seasonOrder(a.seasonId) || (a.damageRank as number) - (b.damageRank as number));
const best = p.rift.length ? Math.max(...p.rift.map((r) => r.floor)) : null;
const bestRank = p.rift.length ? Math.min(...p.rift.map((r) => r.rank)) : null;
const server = [...p.rift].reverse().find((r) => r.server != null)?.server ?? null;
// Guild leaders with no Rift row: show the region their guild was in when they led it (guilds have regions, not servers).
const ledRegion = server == null ? [...p.led].reverse().find((r) => r.region != null)?.region ?? null : null;
---
<Layout title={p.name} description={`${p.name}: Temporal Rift floors and guilds across every season.`}>
  <section class="page-head">
    <span class="eyebrow">Player</span>
    <h1>{p.name}<StatusTag inactive={p.inactive} /></h1>
    <div class="chips">
      <span class="chip">Player ID {p.id}</span>
      {server != null && <span class="chip">Server {fmtServer(server)}</span>}
      {ledRegion != null && <a class="chip" href={`/region/${ledRegion}/`}>Region {ledRegion}</a>}
      {p.guildId && <a class="chip" href={`/guild/${encodeURIComponent(p.guildId)}/`}>Guild {guildLabel(p.guildId)}</a>}
    </div>
    {otherNames.length > 0 && <p class="muted">Also known as {otherNames.map((n, i) => <>{i > 0 && ', '}<strong>{n}</strong></>)}.</p>}
  </section>

  <div class="tiles">
    <div class="tile"><span class="k">Best Rift floor</span><span class="v">{best == null ? '—' : fmtInt(best)}</span></div>
    <div class="tile"><span class="k">Best Rift rank</span><span class="v">{bestRank == null ? '—' : `#${bestRank}`}</span></div>
    <div class="tile"><span class="k">Rift seasons</span><span class="v">{p.rift.length}</span></div>
    <div class="tile"><span class="k">Guilds</span><span class="v">{tiedGuilds.length}</span><span class="s">{tiedGuilds.length === 1 ? 'guild' : 'guilds'} in their records</span></div>
  </div>

  {riftNewest.length > 0 && (
    <section class="card" id="rift">
      <h2>Temporal Rift</h2>
      <div class="table-wrap">
        <table class="rank">
          <thead><tr><th>Season</th><th class="num">Rank</th><th class="num">Floor</th><th>Name</th><th>Guild</th></tr></thead>
          <tbody>
            {riftNewest.map((r) => {
              const s = seasonById.get(r.seasonId);
              return (
                <tr>
                  <td><a href={`/season/${r.seasonId}/`}>{s ? seasonLabel(s) : r.seasonId}</a></td>
                  <td class="num"><Rank value={r.rank} /></td>
                  <td class="num">{fmtInt(r.floor)}</td>
                  <td>{r.playerName}</td>
                  <td>{r.guildId ? <a href={`/guild/${encodeURIComponent(r.guildId)}/`}>{guildLabel(r.guildId, r.guildName)}</a> : r.guildName || '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {guildRecords.length > 0 && (
    <section class="card" id="guild-records">
      <h2>Guild records</h2>
      <p class="note small muted">AbEx results of every guild this player has been ranked with or led.</p>
      <div class="table-wrap">
        <table class="rank">
          <thead><tr><th>Season</th><th>Guild</th><th class="num">Damage rank</th><th class="num">Damage</th><th class="num">Finish / last attack</th><th>Leader</th></tr></thead>
          <tbody>
            {guildRecords.map((r) => {
              const s = seasonById.get(r.seasonId);
              return (
                <tr>
                  <td><a href={`/season/${r.seasonId}/`}>{s ? seasonLabel(s) : r.seasonId}</a></td>
                  <td><a href={`/guild/${encodeURIComponent(r.guildId)}/`}>{nameOf(r)}</a><GroupTag guildId={r.guildId} />{nameOf(r) !== r.guildName && <span class="listed">listed as {r.guildName}</span>}</td>
                  <td class="num"><Rank value={r.damageRank} tiers="abex" /></td>
                  <td class="num">{fmtM(r.damage)}</td>
                  <td class="num">{r.time ? <span class:list={{ fin: finished(r) }}>{timeNote(r)}</span> : '—'}</td>
                  <td>{r.leaderId === p.id ? <strong>{r.leaderName || p.name} (this player)</strong> : r.leaderId ? <a href={`/player/${r.leaderId}/`}>{r.leaderName}</a> : <span class="muted">—</span>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}
</Layout>
