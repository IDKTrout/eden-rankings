---
import Layout from '../layouts/Layout.astro';
import FilterScript from '../components/FilterScript.astro';
import StatusTag from '../components/StatusTag.astro';
import { players, guildLabel, fmtInt } from '../lib/data';

const list = players.map((p) => ({
  ...p,
  best: p.rift.length ? Math.max(...p.rift.map((r) => r.floor)) : null,
  bestRank: p.rift.length ? Math.min(...p.rift.map((r) => r.rank)) : null,
})).sort((a, b) => (b.best ?? -1) - (a.best ?? -1) || a.name.localeCompare(b.name));

const sections = [
  { id: 'active', title: 'Active', rows: list.filter((p) => !p.inactive) },
  { id: 'inactive', title: 'Inactive', rows: list.filter((p) => p.inactive) },
].filter((s) => s.rows.length > 0);
---
<Layout title="Players" description="Every player in the event rankings, with their best Temporal Rift floor and guild.">
  <section class="page-head">
    <span class="eyebrow">Directory</span>
    <h1>Players</h1>
    <p class="muted">Temporal Rift players and AbEx guild leaders, matched by player ID so name changes stay together. Sorted by best Rift floor.</p>
  </section>

  <div class="card">
    <label class="small muted" for="filter">Search players (<span id="filter-count">{list.length}</span>)</label>
    <input id="filter" class="filter" type="search" placeholder="Name, old name, player ID or guild" autocomplete="off" />
    <p id="filter-empty" class="empty-note" hidden>No player matches that search.</p>
  </div>

  <div data-browse>
    {sections.map((sec) => (
      <section class="card" id={sec.id}>
        <h2>{sec.title} <span class="muted small">{sec.rows.length}</span></h2>
        <div class="table-wrap">
          <table class="rank">
            <thead><tr><th>Player</th><th>Guild</th><th class="num">Best floor</th><th class="num">Best Rift rank</th><th class="num">Player ID</th></tr></thead>
            <tbody>
              {sec.rows.map((p) => (
                <tr>
                <td><a href={`/player/${p.id}/`}>{p.name}</a><StatusTag inactive={p.inactive} /></td>
                <td>{p.guildId ? <a href={`/guild/${encodeURIComponent(p.guildId)}/`}>{guildLabel(p.guildId)}</a> : '—'}</td>
                <td class="num">{p.best == null ? '—' : fmtInt(p.best)}</td>
                <td class="num">{p.bestRank == null ? '—' : `#${p.bestRank}`}</td>
                <td class="num muted">{p.id}</td>
              </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>

  <section class="card" data-results hidden>
    <h2>Search results</h2>
    <div class="table-wrap">
      <table class="rank">
        <thead><tr><th>Player</th><th>Guild</th><th class="num">Best floor</th><th class="num">Best Rift rank</th><th class="num">Player ID</th></tr></thead>
        <tbody>
          {list.map((p) => (
            <tr data-search={[...p.names, p.id, guildLabel(p.guildId), p.inactive ? 'inactive' : 'active'].join(' ')}>
                <td><a href={`/player/${p.id}/`}>{p.name}</a><StatusTag inactive={p.inactive} /></td>
                <td>{p.guildId ? <a href={`/guild/${encodeURIComponent(p.guildId)}/`}>{guildLabel(p.guildId)}</a> : '—'}</td>
                <td class="num">{p.best == null ? '—' : fmtInt(p.best)}</td>
                <td class="num">{p.bestRank == null ? '—' : `#${p.bestRank}`}</td>
                <td class="num muted">{p.id}</td>
              </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <FilterScript />
</Layout>
