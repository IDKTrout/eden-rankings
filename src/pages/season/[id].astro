---
import Layout from '../../layouts/Layout.astro';
import BarList from '../../components/BarList.astro';
import Scatter from '../../components/Scatter.astro';
import Rank from '../../components/Rank.astro';
import Credit from '../../components/Credit.astro';
import GroupTag from '../../components/GroupTag.astro';
import { abexStandings, riftStandings, alnaStandings } from '../../lib/groups';
import { alna, alnaFor, ALNA_MIN_POINTS, ALNA_MAX_RANK, ALNA_BRACKET_TOP } from '../../lib/data';
import {
  seasons, seasonLabel, seasonsOf, abexFor, riftFor, abexSummary, riftSummary, guildLabel,
  fmtInt, fmtM, fmtEss, fmtServer, fmtDate, finished, timeNote, groupById, nameOf, type Season,
} from '../../lib/data';

export function getStaticPaths() {
  return seasons.map((s) => ({ params: { id: s.id }, props: { season: s } }));
}

const { season } = Astro.props as { season: Season };
const label = seasonLabel(season);
const siblings = seasonsOf(season.kind);

const abexRows = season.kind === 'abex' ? abexFor(season.id) : [];
const aSum = season.kind === 'abex' ? abexSummary(season.id) : null;
const ranked = abexRows.filter((r) => r.damageRank != null && r.damage != null);
const top20 = ranked.slice(0, 20);
const timed = ranked.filter((r) => r.seconds != null);
const withEssence = abexRows.filter((r) => r.damage != null && r.essence != null);
const anyFinished = !!aSum && aSum.finished > 0;

const riftRows = season.kind === 'rift' ? riftFor(season.id) : [];
const alnaRows = season.kind === 'alna' ? alnaFor(season.id) : [];
const lStand = season.kind === 'alna' ? alnaStandings(season.id) : [];
const alnaAll = season.kind === 'alna' ? alna.filter((r) => r.seasonId === season.id) : [];
const alnaBrackets = [...new Set(alnaAll.map((r) => r.bracket))].sort((a, b) => a - b);
const fmtPts = (r: { points: number | null; rounded: boolean }) => (r.points == null ? '—' : `${r.rounded ? '≈ ' : ''}${fmtInt(r.points)}`);
const eyebrow = season.kind === 'abex' ? 'AbEx · guild damage' : season.kind === 'alna' ? 'Alna · guild points by bracket' : 'Temporal Rift · player floors';
const rSum = season.kind === 'rift' ? riftSummary(season.id) : null;
const aStand = season.kind === 'abex' ? abexStandings(season.id) : [];
const rStand = season.kind === 'rift' ? riftStandings(season.id) : [];

const guildHref = (id: string) => (id ? `/guild/${encodeURIComponent(id)}/` : undefined);
const playerHref = (id: string) => (id ? `/player/${encodeURIComponent(id)}/` : undefined);
---
<Layout title={label} description={season.title}>
  <section class="page-head">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{label}</h1>
    {season.endDate && <p class="muted">Ended <time datetime={season.endDate}>{fmtDate(season.endDate)}</time></p>}
    {siblings.length > 1 && (
      <nav class="chips" aria-label="Other seasons">
        {siblings.map((s) => (
          <a class="chip" href={`/season/${s.id}/`} aria-current={s.id === season.id ? 'page' : undefined}>{seasonLabel(s)}</a>
        ))}
      </nav>
    )}
    <Credit season={season} />
  </section>

  {aSum && (
    <>
      {aSum.finished > 1 && aSum.fastest ? (
        <p class="lede"><strong>{aSum.finished} guilds</strong> reached the max damage of <strong>{fmtM(aSum.max)}</strong>. <a href={guildHref(aSum.fastest.guildId)}><strong>{nameOf(aSum.fastest)}</strong></a> finished first, in <strong>{aSum.fastest.time}</strong>.</p>
      ) : aSum.finished === 1 && aSum.fastest ? (
        <p class="lede">Only <a href={guildHref(aSum.fastest.guildId)}><strong>{nameOf(aSum.fastest)}</strong></a> reached the max damage of <strong>{fmtM(aSum.max)}</strong>, finishing in <strong>{aSum.fastest.time}</strong>.{aSum.nextBest && <> <a href={guildHref(aSum.nextBest.guildId)}>{nameOf(aSum.nextBest)}</a> came closest at <strong>{fmtM(aSum.nextBest.damage)}</strong>.</>}</p>
      ) : (
        <p class="lede">No guild reached the max damage{aSum.maxRecorded && <> of <strong>{fmtM(aSum.max)}</strong></>}. <a href={guildHref(aSum.leader.guildId)}><strong>{nameOf(aSum.leader)}</strong></a> dealt the most, <strong>{fmtM(aSum.top)}</strong>.</p>
      )}

      <div class="tiles">
        <div class="tile"><span class="k">Guilds ranked</span><span class="v">{fmtInt(aSum.guilds)}</span><span class="s">by damage</span></div>
        <div class="tile"><span class="k">Max damage</span><span class="v">{fmtInt(aSum.max)}</span><span class="s">millions, needed to finish</span></div>
        <div class="tile"><span class="k">Finished</span><span class="v">{fmtInt(aSum.finished)}</span><span class="s">{aSum.finished === 1 ? 'guild reached' : 'guilds reached'} the max</span></div>
        <div class="tile"><span class="k">Median damage</span><span class="v">{fmtInt(Math.round(aSum.median))}</span><span class="s">millions, across ranked guilds</span></div>
      </div>

      <div class="grid-2">
        <section class="card" id="top-damage">
          <h2>Top 20 by damage</h2>
          <p class="note">Damage in millions.{anyFinished && ' Gold bars reached the max damage and finished.'}</p>
          <BarList
            label={`Top 20 guilds by damage in ${label}`}
            bars={top20.map((r) => ({
              label: nameOf(r), value: r.damage as number, display: fmtInt(r.damage),
              href: guildHref(r.guildId), highlight: finished(r),
              detail: `#${r.damageRank} ${nameOf(r)}: ${fmtM(r.damage)}. ${timeNote(r)}`,
            }))}
          />
        </section>
        {timed.length > 1 && (
          <section class="card" id="damage-time">
            <h2>Damage and time</h2>
            <p class="note">Each dot is a guild. Up: damage in millions. Across: hours into the event. Gold dots reached the max damage, so their time is when they finished. Blue dots did not finish, so their time is their last attack. Select a dot to open the guild.</p>
            <Scatter
              label={`Damage against finish or last-attack time for ${timed.length} guilds in ${label}`}
              points={timed.map((r) => ({
                x: (r.seconds as number) / 3600, y: r.damage as number,
                label: `#${r.damageRank} ${nameOf(r)}: ${fmtM(r.damage)}. ${timeNote(r)}`,
                highlight: finished(r), href: guildHref(r.guildId),
              }))}
              xTicks={(v) => `${v}h`}
              yTicks={(v) => (v === 0 ? '0' : v >= 1e6 ? `${(v / 1e6).toLocaleString('en-US')}T` : `${(v / 1e3).toLocaleString('en-US')}B`)}
            />
            <p class="note">On the up axis, 1T is 1,000,000M and 500B is 500,000M.</p>
          </section>
        )}
        {withEssence.length > 1 && (
          <section class="card" id="damage-essence">
            <h2>Damage and essence</h2>
            <p class="note">Guilds in both the damage and essence rankings. Across: damage. Up: essence in millions.</p>
            <Scatter
              label={`Essence against damage for ${withEssence.length} guilds in ${label}`}
              points={withEssence.map((r) => ({
                x: r.damage as number, y: r.essence as number,
                label: `${nameOf(r)}: damage ${fmtM(r.damage)}, essence ${fmtEss(r.essence)}`,
                href: guildHref(r.guildId),
              }))}
              xTicks={(v) => (v === 0 ? '0' : v >= 1e6 ? `${(v / 1e6).toLocaleString('en-US')}T` : `${(v / 1e3).toLocaleString('en-US')}B`)}
              yTicks={(v) => `${v}M`}
            />
          </section>
        )}
      </div>

      {aStand.length > 0 && (
        <section class="card" id="groups">
          <h2>Groups</h2>
          <p class="note">How each group's guilds placed this season, ordered by their best guild. Groups use each guild's current group.</p>
          <div class="table-wrap">
            <table class="rank">
              <thead><tr><th>Group</th><th class="num"><span class="hide-sm">Guilds ranked</span><span class="show-sm">Guilds</span></th><th>Best guild</th><th class="num hide-sm">Finished</th><th class="num hide-sm">Total damage</th></tr></thead>
              <tbody>
                {aStand.map((g) => (
                  <tr>
                    <td><a href={`/group/${g.groupId}/`}>{groupById.get(g.groupId)?.name}</a></td>
                    <td class="num">{g.guilds}</td>
                    <td class="wrap-sm"><Rank value={g.best.damageRank} tiers="abex" /> <a href={guildHref(g.best.guildId)}>{nameOf(g.best)}</a></td>
                    <td class="num hide-sm">{g.finished}</td>
                    <td class="num hide-sm">{fmtM(g.totalDamage)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="card" id="ranking">
        <h2>Full ranking</h2>
        <p class="note small muted">Bold times are when a guild finished (reached the max damage). Other times are the guild's last attack.</p>
        <ul class="tier-key" aria-label="Rank tiers">
          <li><span class="medal gold"></span>Gold: ranks 1–5</li>
          <li><span class="medal silver"></span>Silver: 6–10</li>
          <li><span class="medal bronze"></span>Bronze: 11–50</li>
        </ul>
        <div class="table-wrap tall">
          <table class="rank">
            <thead>
              <tr>
                <th class="num">Rank</th><th>Guild</th><th class="hide-sm">Leader</th><th class="hide-sm">Server</th>
                <th class="num">Damage (M)<span class="show-sm sub">time</span></th><th class="num hide-sm">Finish / last attack</th>
                {aSum.hasEssence && <><th class="num hide-sm">Essence rank</th><th class="num hide-sm">Essence (M)</th></>}
              </tr>
            </thead>
            <tbody>
              {abexRows.map((r) => (
                <tr>
                  <td class="num"><Rank value={r.damageRank} tiers="abex" /></td>
                  <td class="wrap-sm"><a href={guildHref(r.guildId)}>{nameOf(r)}</a><GroupTag guildId={r.guildId} />{nameOf(r) !== r.guildName && <span class="listed">listed as {r.guildName}</span>}<span class="show-sm sub">{[r.leaderName, r.server != null ? fmtServer(r.server) : ''].filter(Boolean).join(' · ')}</span></td>
                  <td class="hide-sm">{r.leaderId ? <a href={playerHref(r.leaderId)}>{r.leaderName}</a> : <span class="muted">—</span>}</td>
                  <td class="hide-sm">{fmtServer(r.server)}</td>
                  <td class="num">{fmtInt(r.damage)}{r.time && <span class:list={['show-sm', 'sub', { fin: finished(r) }]}>{r.time}</span>}</td>
                  <td class="num hide-sm">{r.time ? <span class:list={{ fin: finished(r) }} title={timeNote(r)}>{r.time}</span> : '—'}</td>
                  {aSum.hasEssence && <><td class="num hide-sm">{r.essenceRank ?? '—'}</td><td class="num hide-sm">{r.essence == null ? '—' : fmtEss(r.essence).replace('M', '')}</td></>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}

  {rSum && (
    <>
      <p class="lede"><a href={playerHref(rSum.top.playerId)}><strong>{rSum.top.playerName}</strong></a> reached floor <strong>{fmtInt(rSum.top.floor)}</strong>, and floor <strong>{fmtInt(rSum.cutoff)}</strong> was enough for {rSum.players === 100 ? '100th' : `#${rSum.players}`} place.</p>

      <div class="tiles">
        <div class="tile"><span class="k">Highest floor</span><span class="v">{fmtInt(rSum.top.floor)}</span><span class="s">{rSum.top.playerName}</span></div>
        <div class="tile"><span class="k">Floor for last place</span><span class="v">{fmtInt(rSum.cutoff)}</span><span class="s">rank {rSum.players}</span></div>
        <div class="tile"><span class="k">Guilds represented</span><span class="v">{fmtInt(rSum.guilds.length)}</span><span class="s">with a player in the ranking</span></div>
        {rSum.guilds[0] && <div class="tile"><span class="k">Most players</span><span class="v">{rSum.guilds[0].players}</span><span class="s">{rSum.guilds[0].name}</span></div>}
      </div>

      <div class="grid-2">
        <section class="card" id="floors">
          <h2>Floor reached by rank</h2>
          <p class="note">Each dot is a player. Across: rank. Up: highest floor. Select a dot to open the player.</p>
          <Scatter
            label={`Highest floor by rank for ${riftRows.length} players in ${label}`}
            line
            points={riftRows.map((r) => ({ x: r.rank, y: r.floor, label: `#${r.rank} ${r.playerName}: floor ${r.floor}`, href: playerHref(r.playerId) }))}
            xTicks={(v) => (v < 1 ? '' : `#${v}`)}
          />
        </section>
        <section class="card" id="guild-counts">
          <h2>Guilds with the most players</h2>
          <p class="note">Players in this ranking from each guild, top 15.</p>
          <BarList
            label={`Guilds with the most players in ${label}`}
            bars={rSum.guilds.slice(0, 15).map((g) => ({
              label: g.name, value: g.players, display: String(g.players), href: guildHref(g.guildId),
              detail: `${g.name}: ${g.players} players, best floor ${g.best}`,
            }))}
          />
        </section>
      </div>

      {rStand.length > 0 && (
        <section class="card" id="groups">
          <h2>Groups</h2>
          <p class="note">Players in this ranking from each group's guilds. Groups use each guild's current group.</p>
          <div class="table-wrap">
            <table class="rank">
              <thead><tr><th>Group</th><th class="num">Players</th><th>Best player</th><th class="num">Floor</th></tr></thead>
              <tbody>
                {rStand.map((g) => (
                  <tr>
                    <td><a href={`/group/${g.groupId}/`}>{groupById.get(g.groupId)?.name}</a></td>
                    <td class="num">{g.players}</td>
                    <td class="wrap-sm"><Rank value={g.best.rank} /> <a href={playerHref(g.best.playerId)}>{g.best.playerName}</a></td>
                    <td class="num">{fmtInt(g.best.floor)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="card" id="ranking">
        <h2>Full ranking</h2>
        <div class="table-wrap tall">
          <table class="rank">
            <thead><tr><th class="num">Rank</th><th>Player</th><th class="num">Floor</th><th class="hide-sm">Server</th><th>Guild</th></tr></thead>
            <tbody>
              {riftRows.map((r) => (
                <tr>
                  <td class="num"><Rank value={r.rank} /></td>
                  <td class="wrap-sm"><a href={playerHref(r.playerId)}>{r.playerName}</a>{r.server != null && <span class="show-sm sub">{fmtServer(r.server)}</span>}</td>
                  <td class="num">{fmtInt(r.floor)}</td>
                  <td class="hide-sm">{fmtServer(r.server)}</td>
                  <td class="wrap-sm">{r.guildId ? <><a href={guildHref(r.guildId)}>{nameOf(r)}</a><GroupTag guildId={r.guildId} />{nameOf(r) !== r.guildName && <span class="listed">listed as {r.guildName}</span>}</> : r.guildName || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}

  {season.kind === 'alna' && alnaRows.length > 0 && (
    <>
      <p class="lede"><a href={guildHref(alnaRows[0].guildId)}><strong>{nameOf(alnaRows[0])}</strong></a> leads overall with <strong>{fmtPts(alnaRows[0])}</strong> points, across <strong>{alnaBrackets.length} brackets</strong>.</p>

      <div class="tiles">
        <div class="tile"><span class="k">Brackets</span><span class="v">{alnaBrackets.length}</span><span class="s">each ranked separately in game</span></div>
        <div class="tile"><span class="k">Guilds shown</span><span class="v">{alnaRows.length}</span><span class="s">bracket top {ALNA_BRACKET_TOP}, or top {ALNA_MAX_RANK} over {fmtInt(ALNA_MIN_POINTS)} points</span></div>
        <div class="tile"><span class="k">Top points</span><span class="v">{fmtPts(alnaRows[0])}</span><span class="s">{nameOf(alnaRows[0])}</span></div>
        <div class="tile"><span class="k">Bracket winners</span><span class="v">{alnaRows.filter((r) => r.bracketRank === 1).length}</span><span class="s">of {alnaBrackets.length} shown</span></div>
      </div>

      <div class="grid-2">
        <section class="card" id="top-points">
          <h2>Top {Math.min(20, alnaRows.length)} by points</h2>
          <p class="note">Points across all brackets. ≈ marks a score the game rounded, such as 13M.</p>
          <BarList
            label={`Top guilds by points in ${label}`}
            bars={alnaRows.slice(0, 20).map((r) => ({
              label: nameOf(r), value: r.points as number, display: fmtPts(r), href: guildHref(r.guildId),
              highlight: r.bracketRank === 1,
              detail: `#${r.overallRank} overall, #${r.bracketRank} in bracket ${r.bracket}: ${fmtPts(r)} points`,
            }))}
          />
          <p class="note">Gold bars won their bracket.</p>
        </section>
        <section class="card" id="brackets">
          <h2>Brackets</h2>
          <p class="note">Each bracket's own ranking, as shown in game.</p>
          <div class="bracket-grid">
            {alnaBrackets.map((b) => {
              const rows = alnaRows.filter((r) => r.bracket === b).sort((x, y) => x.bracketRank - y.bracketRank);
              return (
                <div class="bracket">
                  <h3>Bracket {b}</h3>
                  {rows.length ? (
                    <ol>
                      {rows.map((r) => (
                        <li><Rank value={r.bracketRank} /> <a href={guildHref(r.guildId)}>{nameOf(r)}</a> <span class="muted small">{fmtPts(r)}</span></li>
                      ))}
                    </ol>
                  ) : <p class="muted small">No guild shown.</p>}
                </div>
              );
            })}
          </div>
        </section>
      </div>

      {lStand.length > 0 && (
        <section class="card" id="groups">
          <h2>Groups</h2>
          <p class="note">How each group's guilds placed, ordered by their best guild overall. Groups use each guild's current group.</p>
          <div class="table-wrap">
            <table class="rank">
              <thead><tr><th>Group</th><th class="num">Guilds</th><th>Best guild</th><th class="num"><span class="hide-sm">Bracket wins</span><span class="show-sm">Wins</span></th><th class="num hide-sm">Top 3 finishes</th></tr></thead>
              <tbody>
                {lStand.map((g) => (
                  <tr>
                    <td><a href={`/group/${g.groupId}/`}>{groupById.get(g.groupId)?.name}</a></td>
                    <td class="num">{g.guilds}</td>
                    <td class="wrap-sm"><Rank value={g.best.overallRank} /> <a href={guildHref(g.best.guildId)}>{nameOf(g.best)}</a></td>
                    <td class="num">{g.bracketWins}</td>
                    <td class="num hide-sm">{g.podiums}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="card" id="ranking">
        <h2>Overall ranking</h2>
        <p class="note small muted">All brackets ranked together by points. Guilds tied on points in the same bracket keep that bracket's order; ties across brackets share a rank. Shown: every bracket's top {ALNA_BRACKET_TOP}, plus any guild in the overall top {ALNA_MAX_RANK} with more than {fmtInt(ALNA_MIN_POINTS)} points.</p>
        <div class="table-wrap tall">
          <table class="rank">
            <thead><tr><th class="num">Overall</th><th>Guild</th><th class="num hide-sm">Bracket</th><th class="num">Points</th></tr></thead>
            <tbody>
              {alnaRows.map((r) => (
                <tr>
                  <td class="num"><Rank value={r.overallRank} /></td>
                  <td class="wrap-sm"><a href={guildHref(r.guildId)}>{nameOf(r)}</a><GroupTag guildId={r.guildId} />{nameOf(r) !== r.guildName && <span class="listed">listed as {r.guildName}</span>}<span class="show-sm sub">Bracket {r.bracket} · #{r.bracketRank}</span></td>
                  <td class="num hide-sm">{r.bracket} <span class="muted small">(#{r.bracketRank})</span></td>
                  <td class="num" title={r.rounded ? 'Rounded by the game' : undefined}>{fmtPts(r)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}

  <p class="small muted">Source: {season.title}{season.sourceUrl && <> · <a href={season.sourceUrl} rel="noopener">{season.sourceUrl.replace(/^https?:\/\//, '')}</a></>}</p>
</Layout>

<style>
  .bracket-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: .9rem; }
  .bracket { background: var(--raised); border: 1px solid var(--line); border-radius: 8px; padding: .7rem .8rem; min-width: 0; }
  .bracket h3 { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 .4rem; }
  .bracket ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; font-size: .88rem; }
  .bracket li { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; min-width: 0; overflow-wrap: anywhere; }
</style>
