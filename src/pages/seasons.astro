---
import Layout from '../layouts/Layout.astro';
import Credit from '../components/Credit.astro';
import { seasons, seasonLabel, abexSummary, riftSummary, alnaFor, fmtM, fmtInt, nameOf, fmtDate } from '../lib/data';

const list = [...seasons].reverse().map((s) => {
  if (s.kind === 'abex') {
    const a = abexSummary(s.id);
    return { s, leader: a ? nameOf(a.leader) : '—', stat: a ? fmtM(a.top) : '—', count: a ? `${a.guilds} guilds` : '' };
  }
  if (s.kind === 'alna') {
    const rows = alnaFor(s.id);
    const top = rows[0];
    return { s, leader: top ? nameOf(top) : '—', stat: top?.points != null ? `${top.rounded ? '≈ ' : ''}${fmtInt(top.points)} pts` : '—', count: rows.length ? `${rows.length} guilds over 1M` : '' };
  }
  const r = riftSummary(s.id);
  return { s, leader: r?.top.playerName ?? '—', stat: r ? `Floor ${fmtInt(r.top.floor)}` : '—', count: r ? `${r.players} players` : '' };
});
---
<Layout title="Seasons" description="Every AbEx and Temporal Rift ranking season in the event rankings.">
  <section class="page-head">
    <span class="eyebrow">Archive</span>
    <h1>Seasons</h1>
    <p class="muted">Newest first.</p>
  </section>
  <div class="season-grid">
    {list.map(({ s, leader, stat, count }) => (
      <a class="card season-card" href={`/season/${s.id}/`}>
        <span class="eyebrow">{s.kind === 'abex' ? 'AbEx · guilds' : s.kind === 'alna' ? 'Alna · guilds' : 'Temporal Rift · players'}</span>
        <h2>{seasonLabel(s)}</h2>
        {s.endDate && <p class="muted small">Ended <time datetime={s.endDate}>{fmtDate(s.endDate)}</time></p>}
        <p><span class="muted">Leader</span> <strong>{leader}</strong></p>
        <p class="stat">{stat}</p>
        <p class="muted small">{count}</p>
        <Credit season={s} compact />
      </a>
    ))}
  </div>
</Layout>

<style>
  .season-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: var(--gap); }
  .season-card { text-decoration: none; gap: .35rem; transition: border-color .15s; }
  .season-card:hover { border-color: var(--accent); color: inherit; }
  .season-card h2 { font-family: var(--font-display); font-size: 1.35rem; }
  .stat { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; }
</style>
